<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Felibow.Mobile.ViewModels"
             xmlns:m="clr-namespace:Felibow.Mobile.Models"
             x:Class="Felibow.Mobile.Views.ProdutoDetalhePage" x:DataType="vm:ProdutoDetalheViewModel" Title="Produto">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">
            <Label Text="{Binding Erro}" IsVisible="{Binding TemErro}" TextColor="{StaticResource Danger}" SemanticProperties.HeadingLevel="None" />
<ActivityIndicator IsRunning="{Binding Ocupado}" IsVisible="{Binding Ocupado}" Color="{StaticResource Primary}" />
            <VerticalStackLayout BindingContext="{Binding Produto}" x:DataType="vm:ProdutoItem" Spacing="8">
                <Image Source="{Binding Imagem}" HeightRequest="260" Aspect="AspectFit" SemanticProperties.Description="{Binding Dto.Nome}" />
                <Label Text="{Binding Dto.Nome}" FontSize="22" FontAttributes="Bold" SemanticProperties.HeadingLevel="Level1" />
                <Label Text="{Binding Dto.EdicaoEspecial}" TextColor="{StaticResource TextMuted}" />
                <Label Text="{Binding PrecoTexto}" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                <Label Text="{Binding EstoqueTexto}" TextColor="{StaticResource TextMuted}" />
                <Label Text="{Binding Dto.Descricao}" />
            </VerticalStackLayout>
            <HorizontalStackLayout Spacing="16" HorizontalOptions="Center">
                <Button Text="−" WidthRequest="56" Command="{Binding MenosCommand}" SemanticProperties.Description="Diminuir quantidade" />
                <Label Text="{Binding Quantidade}" FontSize="20" VerticalOptions="Center" />
                <Button Text="+" WidthRequest="56" Command="{Binding MaisCommand}" SemanticProperties.Description="Aumentar quantidade" />
            </HorizontalStackLayout>
            <Label Text="{Binding Mensagem}" TextColor="Green" HorizontalOptions="Center" />
            <Button Text="Adicionar ao carrinho" Command="{Binding AdicionarCommand}" IsEnabled="{Binding NaoOcupado}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
