<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Felibow.Mobile.ViewModels"
             xmlns:m="clr-namespace:Felibow.Mobile.Models"
             x:Class="Felibow.Mobile.Views.CarrinhoPage" x:DataType="vm:CarrinhoViewModel" Title="Carrinho">
    <Grid RowDefinitions="Auto,*,Auto" Padding="12" RowSpacing="8">
        <VerticalStackLayout>
            <Label Text="{Binding Erro}" IsVisible="{Binding TemErro}" TextColor="{StaticResource Danger}" SemanticProperties.HeadingLevel="None" />
<ActivityIndicator IsRunning="{Binding Ocupado}" IsVisible="{Binding Ocupado}" Color="{StaticResource Primary}" />
            <Label Text="{Binding Aviso}" TextColor="{StaticResource Danger}" />
        </VerticalStackLayout>
        <Label Grid.Row="1" Text="Seu carrinho está vazio." HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding Vazio}" />
        <CollectionView Grid.Row="1" ItemsSource="{Binding Itens}" IsVisible="{Binding TemItens}">
            <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Vertical" ItemSpacing="8" /></CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ItemCarrinhoItem">
                    <Border Style="{StaticResource Card}">
                        <Grid ColumnDefinitions="72,*" ColumnSpacing="10">
                            <Image Source="{Binding Imagem}" Aspect="AspectFit" />
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="{Binding Dto.Nome}" FontAttributes="Bold" />
                                <Label Text="{Binding SubtotalTexto}" TextColor="{StaticResource Primary}" />
                                <HorizontalStackLayout Spacing="8">
                                    <Button Text="−" WidthRequest="48" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CarrinhoViewModel}}, x:DataType=vm:CarrinhoViewModel, Path=MenosCommand}" CommandParameter="{Binding .}" />
                                    <Label Text="{Binding Dto.Quantidade}" VerticalOptions="Center" />
                                    <Button Text="+" WidthRequest="48" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CarrinhoViewModel}}, x:DataType=vm:CarrinhoViewModel, Path=MaisCommand}" CommandParameter="{Binding .}" />
                                    <Button Text="Remover" Style="{StaticResource Secondary}" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CarrinhoViewModel}}, x:DataType=vm:CarrinhoViewModel, Path=RemoverCommand}" CommandParameter="{Binding .}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <VerticalStackLayout Grid.Row="2" Spacing="4" IsVisible="{Binding TemItens}">
            <Label Text="{Binding Subtotal, StringFormat='Subtotal: {0}'}" />
            <Label Text="{Binding Frete, StringFormat='Frete: {0}'}" />
            <Label Text="{Binding Total, StringFormat='Total: {0}'}" FontSize="20" FontAttributes="Bold" />
            <Button Text="Finalizar compra" Command="{Binding FinalizarCommand}" IsEnabled="{Binding NaoOcupado}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
