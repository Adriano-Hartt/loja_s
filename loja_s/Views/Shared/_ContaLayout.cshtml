<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Felibow</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/paginal_i.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/conta.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dark.css" asp-append-version="true" />
    <script src="~/js/theme.js" asp-append-version="true"></script>
</head>
<body class="account-site">
    <header class="account-header">
        <a class="account-brand" asp-controller="Home" asp-action="Index">
            <span class="account-logo-mark" aria-hidden="true">S</span>
            <span><strong>FELIBOW</strong><small>FORÇA PARA SUA ROTINA</small></span>
        </a>
        <nav class="account-nav" aria-label="Navegação da loja">
            <a asp-controller="Home" asp-action="Index">Loja</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Conta" asp-action="MinhaConta">Minha conta</a>
                <a asp-controller="Pedido" asp-action="MeusPedidos">Pedidos</a>
                <a asp-controller="Favoritos" asp-action="Index">Favoritos</a>
            }
            else
            {
                <a asp-controller="Conta" asp-action="Login">Entrar</a>
            }
            <a asp-controller="Carrinho" asp-action="Index">Carrinho</a>
        </nav>
    </header>
    <main class="account-main">
        @if (TempData["ContaMensagem"] is string message)
        {
            <div class="account-alert success" role="status">@message</div>
        }
        @if (TempData["ErroConta"] is string error)
        {
            <div class="account-alert error" role="alert">@error</div>
        }
        @RenderBody()
    </main>
    <footer class="account-footer">
        <span>© 2026 Felibow</span>
        <a asp-controller="Suporte" asp-action="Index">Precisa de ajuda?</a>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
