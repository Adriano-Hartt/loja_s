@model IReadOnlyList<loja_s.Models.Produto>
@{
    Layout = null;
    ViewData["Title"] = "Felibow - Home";
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Felibow</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/paginal_i.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/dark.css" asp-append-version="true" />
    <script src="~/js/theme.js" asp-append-version="true"></script>
</head>
<body>

    <!-- Cabeçalho -->
    <header class="header">
        <a class="logo" asp-controller="Home" asp-action="Index" aria-label="Felibow — página inicial">
            <span class="logo-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false">
                    <path d="M13.2 2.5 5.8 13h5.1l-.6 8.5L18.2 11h-5.1l.1-8.5Z" />
                </svg>
            </span>
            <span class="logo-copy">
                <strong>FELIBOW</strong>
                <small>FORÇA PARA SUA ROTINA</small>
            </span>
        </a>

        <form class="search-bar" role="search" asp-controller="Home" asp-action="Index" method="get">
            <label class="visually-hidden" for="product-search">Buscar produtos</label>
            <input id="product-search" name="q" type="search" value="@ViewBag.Busca" placeholder="O que você está procurando?">
            <button class="search-btn" type="submit" aria-label="Buscar">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <circle cx="10.8" cy="10.8" r="6.3" />
                    <path d="m15.5 15.5 4.2 4.2" />
                </svg>
            </button>
        </form>

        <div class="user-actions">
            <a asp-controller="Conta"
               asp-action="@(User.Identity?.IsAuthenticated == true ? "MinhaConta" : "Login")" class="header-action icon-user">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <circle cx="12" cy="8" r="3.5" />
                    <path d="M5.2 20c.5-3.6 3.2-5.6 6.8-5.6s6.3 2 6.8 5.6" />
                </svg>
                <span>Minha conta</span>
            </a>
            <a asp-controller="Favoritos" asp-action="Index" class="header-action">
                <span aria-hidden="true">♡</span>
                <span>Favoritos</span>
            </a>
            <a asp-controller="Carrinho" asp-action="Index" class="header-action icon-cart" aria-label="Carrinho de compras">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M3 4h2l2.1 10.1a2 2 0 0 0 2 1.6h8.2a2 2 0 0 0 1.9-1.5L21 8H6" />
                    <circle cx="9.5" cy="20" r="1.2" />
                    <circle cx="18" cy="20" r="1.2" />
                </svg>
                <span>Carrinho</span>
            </a>
        </div>
    </header>

    <!-- Carrossel de Destaque -->
    <section class="carousel" data-carousel aria-label="Produtos em destaque">
        <div class="carousel-track">
            <article class="carousel-slide is-active"
                     aria-roledescription="slide"
                     aria-label="1 de 3"
                     aria-hidden="false">
                <a class="carousel-banner-link"
                   asp-controller="Home"
                   asp-action="Index"
                   asp-route-q="Pré-treino"
                   aria-label="Ver pré-treinos">
                    <img class="carousel-banner-image"
                         src="~/img/banner/banner-pretreino.png"
                         alt="Banner Felibow: mais energia para o seu treino, com os pré-treinos DuoPower e TurboVolt." />
                </a>
            </article>

            <article class="carousel-slide"
                     aria-roledescription="slide"
                     aria-label="2 de 3"
                     aria-hidden="true"
                     inert>
                <a class="carousel-banner-link"
                   asp-controller="Home"
                   asp-action="Produto_1"
                   aria-label="Ver suplementos em pó para performance">
                    <img class="carousel-banner-image"
                         src="~/img/banner/banner-po.png"
                         alt="Banner Felibow: creatina VitaPrime, whey WheyCore e glutamina GlutaFlow." />
                </a>
            </article>

            <article class="carousel-slide"
                     aria-roledescription="slide"
                     aria-label="3 de 3"
                     aria-hidden="true"
                     inert>
                <a class="carousel-banner-link"
                   asp-controller="Home"
                   asp-action="Index"
                   asp-route-q="cápsulas"
                   aria-label="Ver suplementos em cápsulas">
                    <img class="carousel-banner-image"
                         src="~/img/banner/banner-capsulas.png"
                         alt="Banner Felibow: cápsulas MagnaBalance, MultiVida e SolVita." />
                </a>
            </article>
        </div>

        <button class="carousel-control carousel-previous" type="button" aria-label="Banner anterior">
            <span aria-hidden="true">‹</span>
        </button>
        <button class="carousel-control carousel-next" type="button" aria-label="Próximo banner">
            <span aria-hidden="true">›</span>
        </button>

        <div class="carousel-footer">
            <div class="carousel-thumbs" aria-label="Escolher banner">
                <button class="thumb is-active" type="button" aria-label="Mostrar banner de pré-treinos" aria-current="true" data-slide-to="0"></button>
                <button class="thumb" type="button" aria-label="Mostrar banner de suplementos em pó" aria-current="false" data-slide-to="1"></button>
                <button class="thumb" type="button" aria-label="Mostrar banner de cápsulas" aria-current="false" data-slide-to="2"></button>
            </div>
            <button class="carousel-toggle" type="button" aria-label="Pausar troca automática" aria-pressed="false">Ⅱ</button>
        </div>
    </section>

    <main class="product-grid">
        <div class="products-heading">
            <h1>Nossos produtos</h1>
            <p>Encontre o suplemento ideal para sua rotina.</p>
        </div>

        <form class="catalog-filters" asp-controller="Home" asp-action="Index" method="get">
            <input name="q" type="search" value="@ViewBag.Busca" placeholder="Buscar por nome ou descrição" aria-label="Buscar produtos" />
            <select name="ordenar" aria-label="Ordenar produtos">
                <option value="">Ordenar por nome</option>
                <option value="menor-preco" selected="@(ViewBag.Ordenacao as string == "menor-preco" ? "selected" : null)">Menor preço</option>
                <option value="maior-preco" selected="@(ViewBag.Ordenacao as string == "maior-preco" ? "selected" : null)">Maior preço</option>
            </select>
            <button class="buy-btn" type="submit">Buscar</button>
        </form>

        @if (Model.Count == 0)
        {
            <p class="catalog-empty">Não encontramos produtos para esta busca.</p>
        }
        else
        {
            @foreach (var produto in Model)
            {
                <article class="product-card">
                    <a class="product-img" asp-controller="Home" asp-action="VerProduto" asp-route-id="@produto.Id">
                        @if (!string.IsNullOrWhiteSpace(produto.ImagemUrl))
                        {
                            <img src="@Url.Content(produto.ImagemUrl)" alt="@produto.Nome" />
                        }
                        else
                        {
                            <span>Imagem indisponível</span>
                        }
                    </a>
                    <div class="product-info">
                        <span class="producer"><a asp-controller="Home" asp-action="VerProduto" asp-route-id="@produto.Id">@produto.Nome</a></span>
                        @if (produto.PrecoEfetivo < produto.Preco)
                        {
                            <span class="price-old">R$ @produto.Preco.ToString("N2")</span>
                        }
                        <span class="price">R$ @produto.PrecoEfetivo.ToString("N2")</span>
                        <span class="product-availability">@(produto.Estoque > 0 ? "Disponível" : "Indisponível")</span>
                        <a class="buy-btn" asp-controller="Home" asp-action="VerProduto" asp-route-id="@produto.Id">VER PRODUTO</a>
                    </div>
                </article>
            }
        }
    </main>
    <footer class="footer">
        <div class="footer-shell">
            <div class="footer-brand">
                <a class="logo footer-logo" asp-controller="Home" asp-action="Index" aria-label="Felibow — página inicial">
                    <span class="logo-mark" aria-hidden="true">
                        <svg viewBox="0 0 24 24" focusable="false">
                            <path d="M13.2 2.5 5.8 13h5.1l-.6 8.5L18.2 11h-5.1l.1-8.5Z" />
                        </svg>
                    </span>
                    <span class="logo-copy">
                        <strong>FELIBOW</strong>
                        <small>FORÇA PARA SUA ROTINA</small>
                    </span>
                </a>
                <p>Produtos pensados para reforçar sua rotina, melhorar o desempenho e te manter em movimento.</p>
            </div>

            <div class="footer-column">
                <h3>Loja</h3>
                <ul>
                    <li><a href="#">Whey Protein</a></li>
                    <li><a href="#">Creatina</a></li>
                    <li><a href="#">Pré-treino</a></li>
                    <li><a href="#">Vitaminas</a></li>
                </ul>
            </div>

            <div class="footer-column">
                <h3>Atendimento</h3>
                <ul>
                    <li><a href="tel:+5561999999999">(61) 99999-9999</a></li>
                    <li><a href="mailto:atendimento@suplementos.com.br">atendimento@suplementos.com.br</a></li>
                    <li><a href="#">Trocas e devoluções</a></li>
                    <li><a href="#">FAQ</a></li>
                </ul>
            </div>

            <div class="footer-column">
                <h3>Pagamento</h3>
                <div class="payment-methods" aria-label="Métodos de pagamento">
                    <span>Visa</span>
                    <span>Mastercard</span>
                    <span>Pix</span>
                    <span>Boleto</span>
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <span>© 2026 Felibow</span>
            <a href="#">Termos e condições</a>
            <a href="#">Política de privacidade</a>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>