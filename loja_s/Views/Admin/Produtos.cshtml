@model List<loja_s.Models.Produto>
@{ ViewData["Title"] = "Produtos"; }
<h1>Produtos e estoque</h1>
<form method="get" class="card">
    <label for="busca">Buscar por nome ou SKU</label>
    <input id="busca" name="busca" value="@ViewBag.Busca" />
    <p><button type="submit">Buscar</button></p>
</form>
<div class="card scroll">
    <table>
        <thead><tr><th>Produto</th><th>SKU</th><th>Preço</th><th>Estoque</th><th>Mín.</th><th>Status</th><th></th></tr></thead>
        <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Nome</td><td>@p.SKU</td><td>R$ @p.Preco.ToString("N2")</td>
                <td style="@(p.Estoque <= p.EstoqueMinimo ? "color:var(--danger);font-weight:700" : "")">@p.Estoque</td>
                <td>@p.EstoqueMinimo</td><td>@p.Status</td>
                <td><a asp-action="EditarProduto" asp-route-id="@p.Id">Editar</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>
