@model loja_s.Controllers.EditarProdutoViewModel
@{ ViewData["Title"] = "Editar produto"; }
<h1>@Model.Nome</h1>
<div class="card">
    <form asp-action="EditarProduto" method="post">
        <input type="hidden" asp-for="Id" /><input type="hidden" asp-for="SKU" /><input type="hidden" asp-for="Estoque" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <label asp-for="Nome">Nome</label><input asp-for="Nome" /><span asp-validation-for="Nome" class="text-danger"></span>
        <label asp-for="Preco">Preço (R$)</label><input asp-for="Preco" type="number" step="0.01" /><span asp-validation-for="Preco" class="text-danger"></span>
        <label asp-for="PrecoPromocional">Preço promocional (opcional)</label><input asp-for="PrecoPromocional" type="number" step="0.01" /><span asp-validation-for="PrecoPromocional" class="text-danger"></span>
        <label asp-for="EstoqueMinimo">Estoque mínimo</label><input asp-for="EstoqueMinimo" type="number" /><span asp-validation-for="EstoqueMinimo" class="text-danger"></span>
        <label asp-for="Status">Status</label>
        <select asp-for="Status"><option>Ativo</option><option>Inativo</option><option>Descontinuado</option></select>
        <label asp-for="Descricao">Descrição</label><textarea asp-for="Descricao" rows="4"></textarea>
        <p><button type="submit">Salvar</button> <a asp-action="Produtos" class="btn btn-light">Voltar</a></p>
    </form>
</div>
<div class="card">
    <h2>Ajustar estoque (atual: @Model.Estoque)</h2>
    <form asp-action="AjustarEstoque" method="post">
        <input type="hidden" name="id" value="@Model.Id" />
        <label for="tipo">Tipo</label>
        <select id="tipo" name="tipo"><option value="Entrada">Entrada</option><option value="Saida">Saída</option><option value="Ajuste">Ajuste (define o saldo)</option></select>
        <label for="quantidade">Quantidade</label><input id="quantidade" name="quantidade" type="number" min="0" required />
        <label for="motivo">Motivo</label><input id="motivo" name="motivo" maxlength="300" required />
        <p><button type="submit">Registrar movimentação</button></p>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
